# Slack MCP Server Configuration
# Copy to .env and fill in your values

# Required: Slack User OAuth token (xoxp-...)
# Get from: api.slack.com/apps -> Your App -> OAuth & Permissions -> User OAuth Token
SLACK_MCP_XOXP_TOKEN=xoxp-your-token-here

# Optional: Path to MCP server binary (defaults to searching PATH)
# SLACK_MCP_SERVER=/path/to/slack-mcp-server

# Optional: Enable message posting (disabled by default for safety)
# Set to "true" for all channels, or comma-separated channel IDs to whitelist
# SLACK_MCP_ADD_MESSAGE_TOOL=true

# Optional: Cache file locations (defaults to current directory)
# SLACK_MCP_CHANNELS_CACHE=./.channels_cache_v2.json
# SLACK_MCP_USERS_CACHE=./.users_cache.json
